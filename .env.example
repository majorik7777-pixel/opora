# Пример переменных окружения «Опоры».
#
# Как использовать:
#   1) pnpm setup:dev — создаст корневой .env со случайными AUTH_SECRET и
#      ENCRYPTION_KEY (рекомендуется);
#   2) или скопируй этот файл в .env и заполни значения вручную.
#
# ВАЖНО:
#   - .env лежит в корне репозитория и не коммитится (см. .gitignore).
#     Next.js читает env-файлы относительно каталога приложения, поэтому
#     pnpm setup:dev создаёт симлинк apps/web/.env → ../../.env. На сервере
#     переменные можно передавать окружением процесса без .env.
#   - Секретов в репозитории нет. Пример ниже безопасен: секретные значения
#     оставлены пустыми, их генерирует setup:dev или основатель/деплой.
#   - Переменные валидируются в packages/shared/src/env.ts при старте.

# --- Приложение ---
# Базовый URL. В dev — http://localhost:3000, в production — домен на https.
APP_URL=http://localhost:3000
# Отключает телеметрию Next.js (в репозитории и CI — всегда 1).
NEXT_TELEMETRY_DISABLED=1

# Яндекс.Метрика: номер счётчика (влияет на сборку — NEXT_PUBLIC_*).
NEXT_PUBLIC_YM_ID=

# --- База данных ---
# pglite  — встроенный PostgreSQL (WASM) для локальной разработки и тестов;
# postgres — обычный PostgreSQL 16 (production, а также по желанию локально
#            через infra/docker-compose.yml). См. docs/adr/0002-dev-database-pglite.md
DATABASE_DRIVER=pglite
# Каталог файлов PGlite (относительно корня репозитория). В .gitignore.
PGLITE_DATA_DIR=.data/dev
# Применять миграции при старте приложения. true — для dev/e2e;
# в production — false, миграции запускаются отдельно: pnpm db:migrate.
AUTO_MIGRATE=true
# Строка подключения к PostgreSQL. Нужна только при DATABASE_DRIVER=postgres.
# Формат: postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/ИМЯ_БАЗЫ
DATABASE_URL=

# --- Auth и шифрование (обязательны) ---
# Случайный секрет для HMAC (отпечатки email/IP) и подписи cookie.
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=
# Ключ AES-256-GCM для шифрования чувствительных полей (email, ответы
# онбординга). Ровно 32 байта в base64. Сгенерировать: openssl rand -base64 32
# Потеря ключа = невозможность расшифровать данные, поэтому храни в менеджере
# секретов (production) и делай бэкап.
ENCRYPTION_KEY=
# Показывать dev-ссылку magic link прямо в интерфейсе (только dev/e2e;
# в production не включать).
AUTH_DEV_SHOW_LINK=true
# Транспорт писем: console — письмо печатается в консоль (Phase 0–1);
# smtp — реальная отправка (появится позже, вместе с настройками SMTP).
EMAIL_TRANSPORT=console

# LLM — провайдер через адаптер @opora/llm (ADR-0004, D-031).
# fake               — без сети, детерминированно (dev/test/e2e).
# openai-compatible  — любой OpenAI-совместимый API: OpenCode Go, OpenRouter,
#                      OpenAI, DeepSeek, Groq, локальный vLLM.
# yandex/gigachat/cloudru — production-контур РФ (T-101).
# Текущий тестовый контур — OpenCode Go:
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
# Пример OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=<id модели OpenRouter>

# --- Опционально: только для инфраструктуры ---
# Эти переменные нужны docker-compose (infra/docker-compose.yml), а не
# приложению: приложение ходит в БД по DATABASE_URL. Задавать в .env не
# обязательно — в compose есть безопасные значения по умолчанию.
# POSTGRES_USER=opora
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=opora

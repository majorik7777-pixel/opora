{
  "name": "opora",
  "version": "0.1.0",
  "private": true,
  "description": "«Опора» — сервис психологической самопомощи. Phase 0–1: лендинг → онбординг → главная.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @opora/web dev",
    "build": "pnpm --filter @opora/web build",
    "start": "pnpm --filter @opora/web start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "rm -rf apps/web/.next && pnpm build && playwright test",
    "db:generate": "pnpm --filter @opora/db db:generate",
    "db:migrate": "pnpm --filter @opora/db db:migrate",
    "setup:dev": "node scripts/setup-dev.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
